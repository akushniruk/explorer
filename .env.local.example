NODE_ENV=development

# Local Postgres (Docker)
DATABASE_URL="postgresql://nexus:password@localhost:5432/nexus"
DIRECT_URL="postgresql://nexus:password@localhost:5432/nexus"

# Yellow Network API URL
YELLOW_API_URL="wss://clearnet-sandbox.yellow.com/ws"

YELLOW_WS_REQUEST_TIMEOUT_MS=90000
YELLOW_WS_RECONNECT_BASE_MS=1000
YELLOW_WS_RECONNECT_MAX_MS=60000

SYNC_INTERVAL_MS=90000

# Channels sync configuration
SYNC_CHANNELS_LIMIT=100
SYNC_CHANNELS_BUDGET_MS=30000
SYNC_CHANNELS_SLEEP_MS=1000
SYNC_CHANNELS_REFRESH_MS=1800000

# Assets sync configuration
SYNC_ASSETS_REFRESH_MS=7200000

# App sessions sync configuration
SYNC_APP_SESSIONS_PAGE_SIZE=50
SYNC_APP_SESSIONS_BUDGET_MS=30000
SYNC_APP_SESSIONS_REFRESH_MS=1800000

# Transaction sync configuration
SYNC_TXS_PAGE_SIZE=200
SYNC_TXS_BUDGET_MS=10000

RATE_LIMIT_RPM=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Enable ETag HTTP caching
ENABLE_ETAG=true
