import {
  Controller,
  Get,
  Post,
  Put,
  Delete,
  Body,
  Param,
  Query,
  HttpCode,
  HttpStatus,
} from '@nestjs/common';
import { ApiTags, ApiOperation, ApiParam, ApiQuery } from '@nestjs/swagger';
import {
  ApiSuccessResponse,
  ApiPaginatedResponse,
  ApiErrorResponse,
  PaginationHelper,
  PaginationParams,
} from '../common';
import {
  ChannelNotFoundException,
  InvalidAmountException,
  ChannelAlreadyClosedException,
} from '../common/exceptions';

// Example DTOs - you would create these based on your needs
interface ChannelDto {
  channelId: string;
  participant: string;
  status: string;
  token: string;
  wallet: string;
  amount: string;
  chainId: number;
  adjudicator: string;
  challenge: number;
  nonce: string;
  version: number;
  createdAt: string;
  updatedAt: string;
}

interface CreateChannelDto {
  participant: string;
  token: string;
  wallet: string;
  amount: string;
  chainId: number;
  adjudicator: string;
}

interface UpdateChannelDto {
  amount?: string;
  status?: string;
}

interface ResizeChannelDto {
  newAmount: string;
}

@ApiTags('channels')
@Controller('channels')
export class ChannelsController {
  constructor(private readonly channelService: any) {} // Replace with your actual service

  @Get()
  @ApiOperation({ summary: 'Get all channels with pagination' })
  @ApiPaginatedResponse(ChannelDto, 'Channels retrieved successfully')
  @ApiErrorResponse(500, 'Database connection failed', 'DATABASE_CONNECTION_FAILED')
  @ApiQuery({ name: 'page', required: false, type: Number, description: 'Page number (default: 1)' })
  @ApiQuery({ name: 'limit', required: false, type: Number, description: 'Items per page (default: 10, max: 100)' })
  @ApiQuery({ name: 'sort', required: false, type: String, description: 'Sort field (default: created_at)' })
  @ApiQuery({ name: 'order', required: false, enum: ['asc', 'desc'], description: 'Sort order (default: desc)' })
  async getChannels(@Query() query: PaginationParams) {
    // Pagination helper automatically validates and sanitizes parameters
    const { page, limit, sort, order } = PaginationHelper.validateParams(query);
    
    // Get data and total count in parallel for better performance
    const [channels, total] = await Promise.all([
      this.channelService.getChannels({ page, limit, sort, order }),
      this.channelService.getChannelsCount(),
    ]);

    // Return paginated result - ResponseInterceptor will format it properly
    return PaginationHelper.createPaginatedResult(channels, total, page, limit);
  }

  @Get(':id')
  @ApiOperation({ summary: 'Get channel by ID' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @ApiSuccessResponse(ChannelDto, 'Channel retrieved successfully')
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(500, 'Internal server error', 'INTERNAL_SERVER_ERROR')
  async getChannel(@Param('id') channelId: string) {
    // Service will throw ChannelNotFoundException if not found
    // Global exception filter will handle it automatically
    return await this.channelService.getChannel(channelId);
  }

  @Post()
  @ApiOperation({ summary: 'Create a new channel' })
  @ApiSuccessResponse(ChannelDto, 'Channel created successfully')
  @ApiErrorResponse(400, 'Invalid channel data', 'VALIDATION_ERROR')
  @ApiErrorResponse(409, 'Channel already exists', 'CONFLICT')
  @ApiErrorResponse(503, 'Yellow API unavailable', 'YELLOW_API_CONNECTION_FAILED')
  async createChannel(@Body() createChannelDto: CreateChannelDto) {
    // Validation happens automatically via NestJS validation pipes
    // Business logic exceptions are handled by global filter
    return await this.channelService.createChannel(createChannelDto);
  }

  @Put(':id')
  @ApiOperation({ summary: 'Update channel' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @ApiSuccessResponse(ChannelDto, 'Channel updated successfully')
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(400, 'Invalid update data', 'VALIDATION_ERROR')
  @ApiErrorResponse(409, 'Channel already closed', 'CHANNEL_ALREADY_CLOSED')
  async updateChannel(
    @Param('id') channelId: string,
    @Body() updateChannelDto: UpdateChannelDto,
  ) {
    return await this.channelService.updateChannel(channelId, updateChannelDto);
  }

  @Put(':id/resize')
  @ApiOperation({ summary: 'Resize channel capacity' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @ApiSuccessResponse(ChannelDto, 'Channel resized successfully')
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(400, 'Invalid amount', 'INVALID_AMOUNT')
  @ApiErrorResponse(409, 'Channel already closed', 'CHANNEL_ALREADY_CLOSED')
  @ApiErrorResponse(504, 'Yellow API timeout', 'YELLOW_API_TIMEOUT')
  async resizeChannel(
    @Param('id') channelId: string,
    @Body() resizeDto: ResizeChannelDto,
  ) {
    // Example of manual validation with custom exception
    const amount = BigInt(resizeDto.newAmount);
    if (amount <= 0) {
      throw new InvalidAmountException(
        resizeDto.newAmount,
        'Amount must be positive',
        { 
          operation: 'resize_channel',
          channelId,
          providedValue: resizeDto.newAmount 
        }
      );
    }

    return await this.channelService.resizeChannel(channelId, resizeDto.newAmount);
  }

  @Put(':id/close')
  @ApiOperation({ summary: 'Close channel' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @HttpCode(HttpStatus.OK)
  @ApiSuccessResponse(ChannelDto, 'Channel closed successfully')
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(409, 'Channel already closed', 'CHANNEL_ALREADY_CLOSED')
  @ApiErrorResponse(503, 'Yellow API unavailable', 'YELLOW_API_CONNECTION_FAILED')
  async closeChannel(@Param('id') channelId: string) {
    return await this.channelService.closeChannel(channelId);
  }

  @Delete(':id')
  @ApiOperation({ summary: 'Delete channel (admin only)' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @HttpCode(HttpStatus.NO_CONTENT)
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(403, 'Insufficient permissions', 'FORBIDDEN')
  async deleteChannel(@Param('id') channelId: string) {
    await this.channelService.deleteChannel(channelId);
    // For DELETE operations, you might want to return nothing
    // The ResponseInterceptor handles this gracefully
  }

  @Get(':id/balance')
  @ApiOperation({ summary: 'Get channel balance' })
  @ApiParam({ name: 'id', description: 'Channel ID' })
  @ApiSuccessResponse(Object, 'Channel balance retrieved') // Replace Object with proper balance DTO
  @ApiErrorResponse(404, 'Channel not found', 'CHANNEL_NOT_FOUND')
  @ApiErrorResponse(503, 'Yellow API unavailable', 'YELLOW_API_CONNECTION_FAILED')
  async getChannelBalance(@Param('id') channelId: string) {
    return await this.channelService.getChannelBalance(channelId);
  }

  @Get('participant/:address')
  @ApiOperation({ summary: 'Get channels by participant address' })
  @ApiParam({ name: 'address', description: 'Participant wallet address' })
  @ApiPaginatedResponse(ChannelDto, 'Participant channels retrieved')
  @ApiErrorResponse(400, 'Invalid participant address', 'INVALID_PARTICIPANT')
  async getChannelsByParticipant(
    @Param('address') participantAddress: string,
    @Query() query: PaginationParams,
  ) {
    // Validate Ethereum address format
    if (!/^0x[a-fA-F0-9]{40}$/.test(participantAddress)) {
      throw new InvalidParticipantException(participantAddress, {
        expectedFormat: '0x followed by 40 hexadecimal characters',
        providedFormat: 'Invalid format'
      });
    }

    const { page, limit, sort, order } = PaginationHelper.validateParams(query);
    
    const [channels, total] = await Promise.all([
      this.channelService.getChannelsByParticipant(participantAddress, { page, limit, sort, order }),
      this.channelService.getChannelsByParticipantCount(participantAddress),
    ]);

    return PaginationHelper.createPaginatedResult(channels, total, page, limit);
  }

  @Get('stats/summary')
  @ApiOperation({ summary: 'Get channel statistics summary' })
  @ApiSuccessResponse(Object, 'Channel statistics retrieved') // Replace with proper stats DTO
  @ApiErrorResponse(500, 'Failed to calculate statistics', 'DATABASE_QUERY_FAILED')
  async getChannelStats() {
    return await this.channelService.getChannelStatistics();
  }
}

// Example service implementation showing how to use exceptions
export class ChannelService {
  private readonly logger = new Logger(ChannelService.name);

  constructor(private readonly prisma: any) {} // Replace with PrismaService

  async getChannel(channelId: string): Promise<ChannelDto> {
    this.logger.debug('Retrieving channel', {
      component: 'ChannelService',
      operation: 'get_channel',
      channelId,
    });

    const channel = await this.prisma.channel.findUnique({
      where: { channel_id: channelId },
    });

    if (!channel) {
      throw new ChannelNotFoundException(channelId, {
        searchedAt: new Date().toISOString(),
        operation: 'get_channel',
      });
    }

    this.logger.debug('Channel retrieved successfully', {
      component: 'ChannelService',
      operation: 'get_channel',
      channelId,
      status: channel.status,
    });

    return this.mapChannelToDto(channel);
  }

  async closeChannel(channelId: string): Promise<ChannelDto> {
    this.logger.log('Initiating channel closure', {
      component: 'ChannelService',
      operation: 'close_channel',
      channelId,
    });

    // Check if channel exists
    const existingChannel = await this.getChannel(channelId);

    // Check if already closed
    if (existingChannel.status === 'closed') {
      throw new ChannelAlreadyClosedException(channelId, {
        currentStatus: existingChannel.status,
        closedAt: existingChannel.updatedAt,
      });
    }

    try {
      // Perform closure via Yellow API
      await this.yellowApiService.closeChannel(channelId, existingChannel.wallet);

      // Update local database
      const updatedChannel = await this.prisma.channel.update({
        where: { channel_id: channelId },
        data: { 
          status: 'closed',
          updated_at: new Date(),
        },
      });

      this.logger.log('Channel closed successfully', {
        component: 'ChannelService',
        operation: 'close_channel',
        channelId,
        finalAmount: updatedChannel.amount.toString(),
        closedAt: updatedChannel.updated_at.toISOString(),
      });

      return this.mapChannelToDto(updatedChannel);

    } catch (error) {
      this.logger.error('Channel closure failed', {
        component: 'ChannelService',
        operation: 'close_channel',
        channelId,
        error: error instanceof Error ? error.message : String(error),
      });

      // Re-throw the error - global exception filter will handle it
      throw error;
    }
  }

  private mapChannelToDto(channel: any): ChannelDto {
    return {
      channelId: channel.channel_id,
      participant: channel.participant,
      status: channel.status,
      token: channel.token,
      wallet: channel.wallet,
      amount: channel.amount.toString(),
      chainId: Number(channel.chain_id),
      adjudicator: channel.adjudicator,
      challenge: Number(channel.challenge),
      nonce: channel.nonce.toString(),
      version: Number(channel.version),
      createdAt: channel.created_at.toISOString(),
      updatedAt: channel.updated_at.toISOString(),
    };
  }
}