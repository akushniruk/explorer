{
  "collection": "@nestjs/schematics",
  "projects": {
    "api": {
      "type": "application",
      "root": "src",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": { "deleteOutDir": true }
    },
    "worker": {
      "type": "application",
      "root": "src",
      "entryFile": "worker",
      "sourceRoot": "src",
      "compilerOptions": { "deleteOutDir": false }
    },
    "worker-onchain": {
      "type": "application",
      "root": "src",
      "entryFile": "worker-onchain",
      "sourceRoot": "src",
      "compilerOptions": {
        "deleteOutDir": false,
        "assets": ["worker-onchain/abi/*.json"]
      }
    }
  }
}
