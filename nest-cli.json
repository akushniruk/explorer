{
  "collection": "@nestjs/schematics",
  "projects": {
    "api": {
      "type": "application",
      "root": "src",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": { "deleteOutDir": true }
    },
    "worker": {
      "type": "application",
      "root": "src",
      "entryFile": "worker",
      "sourceRoot": "src",
      "compilerOptions": { "deleteOutDir": false }
    }
  }
}
