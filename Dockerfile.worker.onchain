# Onchain worker Dockerfile (worker-onchain.ts entrypoint)
FROM node:20-alpine AS base

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma

FROM base AS build

RUN pnpm install --frozen-lockfile

COPY . .

RUN npx prisma generate
RUN pnpm run build:worker:onchain

FROM node:20-alpine AS production

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nestjs -u 1001

COPY --from=build --chown=nestjs:nodejs /app/dist ./dist
COPY --from=build --chown=nestjs:nodejs /app/package.json ./
COPY --from=build --chown=nestjs:nodejs /app/pnpm-lock.yaml ./
COPY --from=build --chown=nestjs:nodejs /app/prisma ./prisma
COPY --from=build --chown=nestjs:nodejs /app/node_modules/.pnpm ./node_modules/.pnpm

RUN pnpm install --prod --frozen-lockfile --ignore-scripts

USER nestjs

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD pgrep -f "node dist/src/worker-onchain.js" > /dev/null || exit 1

CMD ["sh", "-c", "if [ \"$AUTO_MIGRATE\" = \"true\" ]; then npx prisma migrate deploy; fi && pnpm run start:worker:onchain"]
