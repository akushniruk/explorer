// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Channel {
  channel_id  String   @id
  chain_id    BigInt
  token       String
  wallet      String
  participant String
  amount      BigInt
  status      String
  challenge   BigInt   @default(0)
  nonce       BigInt   @default(0)
  version     BigInt   @default(0)
  adjudicator String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // Relation to Asset
  asset Asset? @relation(fields: [token, chain_id], references: [token, chain_id])

  @@index([wallet])
  @@index([participant])
  @@index([wallet, participant])
  @@index([participant, wallet])
  @@index([token, chain_id])
  @@index([status, updated_at])
  @@index([created_at])
  @@index([updated_at])
  @@map("channels")
}

model Asset {
  token      String
  chain_id   BigInt
  symbol     String   @db.Citext
  decimals   BigInt
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Reverse relation to Channel
  channels Channel[]

  @@id([token, chain_id])
  @@index([symbol])
  @@index([updated_at])
  @@map("assets")
}

model Ledger {
  id           Int      @id @default(autoincrement())
  account_id   String
  account_type String
  asset_symbol String
  wallet       String
  credit       Decimal  @db.Decimal(64, 18)
  debit        Decimal  @db.Decimal(64, 18)
  created_at   DateTime @default(now())

  @@index([account_id, created_at])
  @@index([wallet, created_at])
  @@index([asset_symbol, created_at])
  @@map("ledgers")
}

model AppSession {
  id           Int      @id @default(autoincrement())
  protocol     String   @default("NitroRPC/0.2")
  session_id   String   @unique
  channel_id   String
  nonce        BigInt
  participants String[]
  weight       Int[]
  quorum       BigInt   @default(100)
  version      BigInt   @default(1)
  status       String
  challenge    BigInt?
  session_data String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@index([channel_id])
  @@index([status, updated_at])
  @@index([updated_at])
  @@map("app_sessions")
}

model RpcStore {
  id        Int      @id @default(autoincrement())
  sender    String   @db.VarChar(255)
  req_id    BigInt
  method    String   @db.VarChar(255)
  params    String   @db.Text
  timestamp BigInt
  req_sig   String[] @db.Text
  response  String   @db.Text
  res_sig   String[] @db.Text

  @@index([req_id])
  @@index([method])
  @@index([sender])
  @@map("rpc_store")
}

model WorkerState {
  id                     String   @id
  lastProcessedTimestamp BigInt
  cursor                 String? // composite cursor "ms:channelId"
  updated_at             DateTime @updatedAt

  @@map("worker_states")
}

model NodeConfig {
  id             String   @id @default("default") // singleton
  broker_address String   @db.VarChar(255)
  updated_at     DateTime @updatedAt

  @@map("node_config")
}

model Network {
  chain_id            BigInt   @id
  name                String   @db.Citext
  custody_address     String   @db.VarChar(255)
  adjudicator_address String   @db.VarChar(255)
  broker_address      String   @db.VarChar(255)
  last_seen_at        DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([name])
  @@index([updated_at])
  @@map("networks")
}

enum NodeRegion {
  europe
  north_america
  south_america
  africa
  asia_pacific
  middle_east
}

model Node {
  id          String  @id @default(dbgenerated("replace(gen_random_uuid()::text, '-'::text, ''::text)"))
  slug        String  @unique // kebab-case stable id
  name        String
  ws_url      String  @db.Text // public WS endpoint to connect
  protocol_family  String @default("clearnode") @db.VarChar(64)
  protocol_version String @default("v0") @db.VarChar(32)
  sync_enabled     Boolean @default(true)
  is_primary       Boolean @default(false)
  description String? @db.Text
  address     String? @db.VarChar(255) // node address for frontend lookup

  website_host String? @db.VarChar(255) // e.g. "app.io"
  icon_key     String? @db.VarChar(128) // e.g. "app" (frontend/CDN asset key)

  country_code String     @db.VarChar(2) // ISO-3166 alpha-2
  region       NodeRegion
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)

  status       String    @default("unknown") // online|degraded|offline|unknown
  available    Boolean   @default(false)
  featured     Boolean   @default(false) // certified/featured nodes like WalletConnect
  latency_ms   Int?
  last_seen_at DateTime?
  node_runtime_version             String?   @db.VarChar(128)
  supported_sig_validators_base64  String?   @db.Text
  last_config_at                   DateTime?
  last_config_raw_payload          Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name, ws_url])
  @@index([region])
  @@index([country_code])
  @@index([status, updated_at])
  @@index([featured])
  @@index([sync_enabled])
  @@index([is_primary])
  @@index([protocol_family, protocol_version])
  @@index([last_config_at])
  @@index([latitude, longitude])
  @@index([updated_at])
  @@map("nodes")
}

model NodeSyncState {
  id              String   @id @default(cuid())
  node_id         String
  resource        String
  cursor_json     Json?
  last_success_at DateTime?
  last_error      String?  @db.Text
  retry_count     Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([node_id, resource])
  @@index([resource, updated_at])
  @@index([node_id, updated_at])
  @@map("node_sync_state")
}

model OnchainChainConfig {
  chain_id            BigInt   @id
  channel_hub_address String   @db.VarChar(255)
  enabled             Boolean  @default(true)
  start_block         BigInt?
  last_synced_block   BigInt?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([enabled, chain_id])
  @@map("onchain_chain_configs")
}

model NodeBlockchainConfig {
  id                       String   @id @default(cuid())
  node_id                  String
  blockchain_id            String   @db.VarChar(64)
  name                     String?  @db.VarChar(128)
  channel_hub_address      String?  @db.VarChar(255)
  locking_contract_address String?  @db.VarChar(255)
  raw_payload              Json?
  last_config_at           DateTime @default(now())
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@unique([node_id, blockchain_id])
  @@index([node_id, updated_at])
  @@index([blockchain_id, updated_at])
  @@map("node_blockchain_configs")
}

model NodeConfigSnapshot {
  id                              String   @id @default(cuid())
  node_id                         String
  node_address                    String?  @db.VarChar(255)
  node_runtime_version            String?  @db.VarChar(128)
  supported_sig_validators_base64 String?  @db.Text
  blockchains_json                Json
  raw_payload                     Json
  captured_at                     DateTime @default(now())
  created_at                      DateTime @default(now())

  @@index([node_id, captured_at])
  @@index([captured_at])
  @@map("node_config_snapshots")
}

model OnchainEvent {
  id               String   @id @default(cuid())
  chain_id         BigInt
  contract_address String   @db.VarChar(255)
  tx_hash          String   @db.VarChar(255)
  log_index        Int
  block_number     BigInt
  block_timestamp  DateTime
  event_name       String   @db.VarChar(128)
  channel_id       String?
  user_wallet      String?  @db.VarChar(255)
  node_address     String?  @db.VarChar(255)
  raw_payload      Json
  observed_at      DateTime @default(now())
  created_at       DateTime @default(now())

  @@unique([chain_id, tx_hash, log_index])
  @@index([chain_id, block_number])
  @@index([event_name, block_timestamp])
  @@index([user_wallet, block_timestamp])
  @@map("onchain_events")
}

model OffchainBalanceSnapshot {
  id               String   @id @default(cuid())
  node_id          String
  wallet           String   @db.VarChar(255)
  asset            String   @db.VarChar(64)
  blockchain_id    String   @db.VarChar(64)
  offchain_balance String
  source_ref       String?  @db.VarChar(255)
  raw_payload      Json?
  captured_at      DateTime @default(now())
  created_at       DateTime @default(now())

  @@index([wallet, captured_at])
  @@index([node_id, captured_at])
  @@index([asset, blockchain_id, captured_at])
  @@map("offchain_balance_snapshots")
}

model OnchainBalanceSnapshot {
  id              String   @id @default(cuid())
  node_id         String
  wallet          String   @db.VarChar(255)
  asset           String   @db.VarChar(64)
  blockchain_id   String   @db.VarChar(64)
  onchain_balance String
  source_ref      String?  @db.VarChar(255)
  raw_payload     Json?
  captured_at     DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([wallet, captured_at])
  @@index([node_id, captured_at])
  @@index([asset, blockchain_id, captured_at])
  @@map("onchain_balance_snapshots")
}

model WalletBalanceLatest {
  id               String   @id @default(cuid())
  node_id          String
  wallet           String   @db.VarChar(255)
  asset            String   @db.VarChar(64)
  blockchain_id    String   @db.VarChar(64)
  offchain_balance String?
  onchain_balance  String?
  balance_delta    String?
  offchain_as_of   DateTime?
  onchain_as_of    DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([node_id, wallet, asset, blockchain_id])
  @@index([wallet, updated_at])
  @@index([node_id, updated_at])
  @@map("wallet_balance_latest")
}

model AssetToken {
  id              String   @id @default(cuid())
  node_id         String
  asset_symbol    String   @db.VarChar(64)
  token_address   String   @db.VarChar(255)
  blockchain_id   String   @db.VarChar(64)
  decimals        String?  @db.VarChar(32)
  raw_payload     Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([node_id, asset_symbol, token_address, blockchain_id])
  @@index([asset_symbol, blockchain_id])
  @@map("asset_tokens")
}

model State {
  id              String   @id @default(cuid())
  node_id         String
  state_id        String
  channel_id      String?
  user_wallet     String   @db.VarChar(255)
  asset           String   @db.VarChar(64)
  epoch           String?  @db.VarChar(64)
  version         String?  @db.VarChar(64)
  transition_type String?  @db.VarChar(64)
  raw_payload     Json
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([node_id, state_id])
  @@index([user_wallet, updated_at])
  @@index([channel_id, updated_at])
  @@map("states")
}

model App {
  id           String   @id @default(cuid())
  node_id      String
  app_id       String
  owner_wallet String?  @db.VarChar(255)
  version      String?  @db.VarChar(64)
  raw_payload  Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([node_id, app_id])
  @@index([owner_wallet, updated_at])
  @@map("apps")
}

model AppAllocation {
  id             String   @id @default(cuid())
  node_id        String
  app_session_id String
  participant    String   @db.VarChar(255)
  asset          String   @db.VarChar(64)
  amount         String
  raw_payload    Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([node_id, app_session_id, participant, asset])
  @@index([app_session_id, updated_at])
  @@index([participant, updated_at])
  @@map("app_allocations")
}

model Transaction {
  id            String   @id @default(cuid())
  node_id       String
  wallet        String   @db.VarChar(255)
  tx_id         String
  blockchain_id String   @db.VarChar(64)
  asset         String   @db.VarChar(64)
  tx_type       String   @db.VarChar(64)
  amount        String
  source        String   @db.VarChar(32) // offchain|onchain
  raw_payload   Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([node_id, source, tx_id])
  @@index([wallet, created_at])
  @@index([source, created_at])
  @@index([asset, blockchain_id, created_at])
  @@map("transactions")
}

model ActionAllowanceSnapshot {
  id              String   @id @default(cuid())
  node_id         String
  wallet          String   @db.VarChar(255)
  allowances_json Json
  raw_payload     Json?
  captured_at     DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([wallet, captured_at])
  @@index([node_id, captured_at])
  @@map("action_allowance_snapshots")
}

model SessionKeyState {
  id           String   @id @default(cuid())
  node_id      String
  key_scope    String   @db.VarChar(64) // channels|app_sessions
  user_address String   @db.VarChar(255)
  session_key  String   @db.VarChar(255)
  expires_at   String?  @db.VarChar(64)
  raw_payload  Json?
  captured_at  DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([user_address, captured_at])
  @@index([node_id, captured_at])
  @@index([key_scope, captured_at])
  @@map("session_key_states")
}
