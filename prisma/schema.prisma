// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Channel {
  channel_id  String   @id
  chain_id    BigInt
  token       String
  wallet      String
  participant String
  amount      BigInt
  status      String
  challenge   BigInt   @default(0)
  nonce       BigInt   @default(0)
  version     BigInt   @default(0)
  adjudicator String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  // Relation to Asset
  asset Asset? @relation(fields: [token, chain_id], references: [token, chain_id])

  @@index([wallet])
  @@index([participant])
  @@index([wallet, participant])
  @@index([participant, wallet])
  @@index([token, chain_id])
  @@index([status, updated_at])
  @@index([created_at])
  @@index([updated_at])
  @@map("channels")
}

model Asset {
  token      String
  chain_id   BigInt
  symbol     String   @db.Citext
  decimals   BigInt
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Reverse relation to Channel
  channels Channel[]

  @@id([token, chain_id])
  @@index([symbol])
  @@index([updated_at])
  @@map("assets")
}

model Ledger {
  id           Int      @id @default(autoincrement())
  account_id   String
  account_type String
  asset_symbol String
  wallet       String
  credit       Decimal  @db.Decimal(64, 18)
  debit        Decimal  @db.Decimal(64, 18)
  created_at   DateTime @default(now())

  @@index([account_id, created_at])
  @@index([wallet, created_at])
  @@index([asset_symbol, created_at])
  @@map("ledgers")
}

model AppSession {
  id           Int      @id @default(autoincrement())
  protocol     String   @default("NitroRPC/0.2")
  session_id   String   @unique
  channel_id   String
  nonce        BigInt
  participants String[]
  weight       Int[]
  quorum       BigInt   @default(100)
  version      BigInt   @default(1)
  status       String
  challenge    BigInt?
  session_data String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@index([channel_id])
  @@index([status, updated_at])
  @@index([updated_at])
  @@map("app_sessions")
}

model RpcStore {
  id        Int      @id @default(autoincrement())
  sender    String   @db.VarChar(255)
  req_id    BigInt
  method    String   @db.VarChar(255)
  params    String   @db.Text
  timestamp BigInt
  req_sig   String[] @db.Text
  response  String   @db.Text
  res_sig   String[] @db.Text

  @@index([req_id])
  @@index([method])
  @@index([sender])
  @@map("rpc_store")
}

model WorkerState {
  id                     String   @id
  lastProcessedTimestamp BigInt
  cursor                 String? // composite cursor "ms:channelId"
  updated_at             DateTime @updatedAt

  @@map("worker_states")
}

model NodeConfig {
  id             String   @id @default("default") // singleton
  broker_address String   @db.VarChar(255)
  updated_at     DateTime @updatedAt

  @@map("node_config")
}

model Network {
  chain_id            BigInt   @id
  name                String   @db.Citext
  custody_address     String   @db.VarChar(255)
  adjudicator_address String   @db.VarChar(255)
  broker_address      String   @db.VarChar(255)
  last_seen_at        DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([name])
  @@index([updated_at])
  @@map("networks")
}

enum NodeRegion {
  europe
  north_america
  south_america
  africa
  asia_pacific
  middle_east
}

model Node {
  id          String  @id @default(cuid())
  slug        String  @unique // kebab-case stable id
  name        String
  ws_url      String  @db.Text // public WS endpoint to connect
  description String? @db.Text
  address     String? @db.VarChar(255) // node address for frontend lookup

  website_host String? @db.VarChar(255) // e.g. "app.io"
  icon_key     String? @db.VarChar(128) // e.g. "app" (frontend/CDN asset key)

  country_code String     @db.VarChar(2) // ISO-3166 alpha-2
  region       NodeRegion
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)

  status       String    @default("unknown") // online|degraded|offline|unknown
  available    Boolean   @default(false)
  featured     Boolean   @default(false) // certified/featured nodes like WalletConnect
  latency_ms   Int?
  last_seen_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name, ws_url])
  @@index([region])
  @@index([country_code])
  @@index([status, updated_at])
  @@index([featured])
  @@index([latitude, longitude])
  @@index([updated_at])
  @@map("nodes")
}
